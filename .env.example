# 留空时仍可跑完整合成流程，但会使用不描述具体动作的演示解说稿。
QWEN_API_KEY=
# 完整音视频先交给 Omni 观察，再由 QWEN_MODEL 整理解说和严格 JSON。
QWEN_MODEL=qwen3.7-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VIDEO_MODEL=qwen3.5-omni-flash
# 如果 Omni 只在百炼业务空间中开通，请改为对应 Workspace 的 compatible-mode 地址。
QWEN_VIDEO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 篮球快动作使用较高抽帧率；30–90 秒片段会按片长自动限制实际值。
QWEN_VIDEO_FPS=4
# Omni 调用或分析副本准备失败时，自动回退到原有关键画面分析。
QWEN_VIDEO_FALLBACK=true
# 对复合投篮结果裁取原片小窗口，以 10 FPS 做第二遍逐帧复核。
# 复核失败会保留第一遍事件时间轴；默认最多额外请求 4 个分组、总计 40 秒。
# 预算耗尽或首次遇到 HTTP 429 时会停止剩余复核，继续使用第一遍结果。
QWEN_LOCAL_SHOT_REVIEW=true
QWEN_LOCAL_SHOT_REVIEW_MAX_REQUESTS=4
QWEN_LOCAL_SHOT_REVIEW_BUDGET_SECONDS=40

# auto 会优先使用系统 ffmpeg，找不到时使用 imageio-ffmpeg 自带版本。
FFMPEG_BINARY=auto

# 默认使用 Qwen Audio Plus 原创赛事男声；网页可切换到 MiniMax 2.8 HD。
TTS_PROVIDER=qwen_audio
QWEN_AUDIO_TTS_MODEL=qwen-audio-3.0-tts-plus
QWEN_AUDIO_TTS_VOICE=longanlufeng
# 已取得明确授权的录制音色只通过服务端别名引用；真实 voice ID 不进入源码或接口响应。
QWEN_AUDIO_VOICE_AUTHORIZED_1_ID=
QWEN_AUDIO_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
QWEN_AUDIO_CUSTOMIZATION_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
MINIMAX_TTS_MODEL=MiniMax/speech-2.8-hd
MINIMAX_TTS_VOICE="Chinese (Mandarin)_Radio_Host"
MINIMAX_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
MINIMAX_ENABLED=false

# 旧 Qwen3-TTS 保留为内部兜底。
QWEN_TTS_MODEL=qwen3-tts-instruct-flash
QWEN_TTS_VOICE=
QWEN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# 未配置百炼密钥时，演示模式会临时使用 macOS 本地中文语音。
MACOS_TTS_VOICE=Tingting
MACOS_TTS_RATE=220

# 可选：任何兼容 OpenAI Speech API 的服务。
# TTS_PROVIDER=openai_compatible
TTS_API_KEY=
TTS_URL=https://api.openai.com/v1/audio/speech
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# 上传限制
MAX_UPLOAD_MB=300
MIN_VIDEO_SECONDS=3
MAX_VIDEO_SECONDS=90
